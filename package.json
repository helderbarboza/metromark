{
  "name": "metromark",
  "type": "module",
  "version": "0.5.0",
  "private": true,
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:chrome": "wxt",
    "dev:firefox": "wxt -b firefox --mv3",
    "build": "npm run build:chrome && npm run build:firefox",
    "build:chrome": "wxt build --mv3",
    "build:firefox": "wxt build -b firefox --mv3",
    "build:preview": "vite build",
    "check": "svelte-check --tsconfig tsconfig.json",
    "lint": "eslint . --cache",
    "lint:fix": "eslint . --cache --fix",
    "test": "vitest run --project unit",
    "test:stories": "vitest run --project storybook",
    "test:e2e": "playwright test",
    "storybook": "storybook dev -p 6006 --host 0.0.0.0 --no-open",
    "build-storybook": "storybook build",
    "package": "node scripts/package.mjs",
    "screenshots": "node scripts/screenshot-profiles.mjs",
    "postinstall": "wxt prepare",
    "generate:themes": "node scripts/generate-themes.mjs",
    "i18n": "typesafe-i18n --no-watch",
    "i18n:watch": "typesafe-i18n",
    "knip": "knip",
    "changelog": "git cliff --config cliff.toml --output CHANGELOG.md",
    "prepare": "husky"
  },
  "dependencies": {
    "@dnd-kit/dom": "0.5.3",
    "@dnd-kit/svelte": "0.4.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@iconify-icons/fluent": "^2.0.0",
    "@iconify/svelte": "^5.2.3",
    "@snapgridjs/core": "0.10.0",
    "@snapgridjs/svelte": "0.10.0",
    "bits-ui": "^2.20.2",
    "mode-watcher": "^1.1.0",
    "svelte": "5.57.2",
    "tailwind-variants": "^3.3.1",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^10.0.0",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@internationalized/date": "^3.12.4",
    "@lucide/svelte": "^1.74.0",
    "@playwright/test": "^1.56.0",
    "@storybook/addon-a11y": "10.6.1",
    "@storybook/addon-docs": "10.6.1",
    "@storybook/addon-svelte-csf": "5.1.5",
    "@storybook/addon-vitest": "10.6.1",
    "@storybook/svelte-vite": "10.6.1",
    "@sveltejs/vite-plugin-svelte": "6.2.4",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "^26.6.6",
    "@vitest/browser": "4.1.11",
    "@vitest/browser-playwright": "4.1.11",
    "@vitest/runner": "4.1.11",
    "@wxt-dev/module-svelte": "2.0.5",
    "cn": "^0.5.2",
    "eslint": "10.15.0",
    "eslint-plugin-better-tailwindcss": "^4.10.0",
    "eslint-plugin-storybook": "10.6.1",
    "eslint-plugin-svelte": "3.23.1",
    "fflate": "0.8.3",
    "geckodriver": "8.0.0",
    "git-cliff": "^2.14.2",
    "husky": "^9.1.7",
    "knip": "^6.45.1",
    "playwright": "^1.56.0",
    "selenium-webdriver": "4.51.0",
    "shadcn-svelte": "^1.7.2",
    "storybook": "10.6.1",
    "svelte-check": "^4.3.0",
    "svelte-sonner": "^1.2.3",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "^1.4.0",
    "typesafe-i18n": "^5.27.1",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "4.1.11",
    "web-ext": "10.7.0",
    "wxt": "0.21.4"
  },
  "overrides": {
    "@typescript-eslint/eslint-plugin": "^8.73.0",
    "@typescript-eslint/parser": "^8.73.0",
    "shell-quote": "1.12.0"
  }
}
