{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "baseUrl": ".",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "paths": {
      "$lib": [
        "src/lib"
      ],
      "$i18n": [
        "src/i18n"
      ],
      "$i18n/*": [
        "src/i18n/*"
      ],
      "$lib/*": [
        "src/lib/*"
      ]
    },
    "resolveJsonModule": true,
    "types": [
      "vite/client",
      "node"
    ],
    "allowJs": true,
    "checkJs": false,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true
  },
  "include": [
    "src/**/*",
    ".storybook/**/*.ts",
    "tests/**/*.ts",
    "e2e/**/*.ts",
    "*.ts"
  ],
  "exclude": [
    "node_modules",
    ".output",
    ".wxt",
    "storybook-static",
    "dist"
  ]
}
